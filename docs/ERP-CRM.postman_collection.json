{
  "info": {
    "name": "Mini ERP + CRM Operations Portal",
    "description": "REST API for the ERP/CRM case study.\n\nSetup:\n1. Set the `baseUrl` collection variable (default http://localhost:4001).\n2. Run **Auth > Login (Sales)** — the test script stores the JWT in the `token` variable automatically.\n3. Every other request inherits Bearer auth from the collection.\n\nRole logins are provided separately so you can demonstrate role-based access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4001" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "challanId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health", "auth": { "type": "noauth" } }
        },
        {
          "name": "API index",
          "request": { "method": "GET", "url": "{{baseUrl}}/api", "auth": { "type": "noauth" } }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erpcrm.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Sales)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erpcrm.com\",\n  \"password\": \"Sales@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Warehouse)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@erpcrm.com\",\n  \"password\": \"Warehouse@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Accounts, read-only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@erpcrm.com\",\n  \"password\": \"Accounts@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login — wrong password (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erpcrm.com\",\n  \"password\": \"wrong\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "List users (admin only)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/users" }
        },
        {
          "name": "Register user (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Sales Rep\",\n  \"email\": \"rep@erpcrm.com\",\n  \"password\": \"Rep@12345\",\n  \"role\": \"SALES\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) pm.collectionVariables.set('customerId', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search + filter customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers?search=shree&status=ACTIVE&customerType=DISTRIBUTOR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "search", "value": "shree" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "customerType", "value": "DISTRIBUTOR" }
              ]
            }
          }
        },
        {
          "name": "Get customer detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/{{customerId}}" }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Yadav\",\n  \"mobile\": \"9876500011\",\n  \"email\": \"ramesh@yadavstores.in\",\n  \"businessName\": \"Yadav Stores\",\n  \"gstNumber\": \"09AACCY1234K1Z8\",\n  \"customerType\": \"WHOLESALE\",\n  \"addressLine\": \"Civil Lines\",\n  \"city\": \"Kanpur\",\n  \"state\": \"Uttar Pradesh\",\n  \"pincode\": \"208001\",\n  \"status\": \"LEAD\",\n  \"notes\": \"Met at the regional trade fair.\"\n}"
            },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Create customer — invalid (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"X\",\n  \"mobile\": \"not-a-number\"\n}" },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\",\n  \"notes\": \"Converted after the second visit.\"\n}" },
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "Add follow-up note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called about the pending rate revision. Sending a revised quote.\",\n  \"followUpDate\": \"2026-08-15T10:00:00.000Z\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/follow-ups"
          }
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) pm.collectionVariables.set('productId', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Low stock only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?lowStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [{ "key": "lowStock", "value": "true" }]
            }
          }
        },
        {
          "name": "Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/categories" }
        },
        {
          "name": "Product detail + ledger",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Create product (warehouse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mustard Oil 1L\",\n  \"sku\": \"OIL-MUS-1L\",\n  \"category\": \"Edible Oil\",\n  \"unitPrice\": 165.50,\n  \"currentStock\": 200,\n  \"minStockAlert\": 50,\n  \"location\": \"Rack A2\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"unitPrice\": 172.00,\n  \"minStockAlert\": 60\n}" },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Stock IN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"IN\",\n  \"quantity\": 100,\n  \"reason\": \"Purchase order PO-2026-0042 received\"\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/stock"
          }
        },
        {
          "name": "Stock OUT — beyond available (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"OUT\",\n  \"quantity\": 999999,\n  \"reason\": \"Deliberate oversell to demonstrate the guard\"\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/stock"
          }
        },
        {
          "name": "Global movement ledger",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/movements/all?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "movements", "all"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "List challans",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) pm.collectionVariables.set('challanId', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Challan detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/challans/{{challanId}}" }
        },
        {
          "name": "Create DRAFT challan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) pm.collectionVariables.set('challanId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"notes\": \"Awaiting transport confirmation.\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/challans"
          }
        },
        {
          "name": "Confirm challan (reduces stock)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/challans/{{challanId}}/confirm" }
        },
        {
          "name": "Confirm again — already confirmed (409)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/challans/{{challanId}}/confirm" }
        },
        {
          "name": "Cancel challan (restores stock)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/challans/{{challanId}}/cancel" }
        },
        {
          "name": "Create CONFIRMED — insufficient stock (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 999999 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/challans"
          }
        },
        {
          "name": "Create — duplicate product line (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 },\n    { \"productId\": \"{{productId}}\", \"quantity\": 3 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/challans"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary" }
        }
      ]
    }
  ]
}
