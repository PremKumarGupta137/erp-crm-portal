# ---- Database ----
# Neon / Supabase / local Postgres connection string.
# Neon example: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/erpcrm?schema=public"

# ---- Auth ----
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ---- Server ----
PORT=4001
NODE_ENV=development

# ---- CORS ----
# Comma separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS="http://localhost:5173"
