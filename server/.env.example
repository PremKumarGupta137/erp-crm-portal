# ---- Database ----
# DATABASE_URL is used at runtime and should be the POOLED endpoint.
# On Neon the pooled host contains "-pooler". Neon drops idle connections, and an
# unpooled client surfaces that as a 500 on the first request after a quiet spell.
# `pgbouncer=true` tells Prisma to skip prepared statements, which PgBouncer's
# transaction mode cannot hold across queries.
# `connection_limit` sizes Prisma's own pool. The default is small, which
# serialises the dashboard's parallel queries; raising it roughly halved that
# endpoint's response time. Safe to raise behind PgBouncer, which multiplexes.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=15"

# DIRECT_URL is used only by `prisma migrate` — DDL needs a direct, unpooled
# session. Same credentials, host WITHOUT "-pooler".
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# For a plain local Postgres (no pooler), set both to the same value:
# DATABASE_URL="postgresql://user:password@localhost:5432/erpcrm?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/erpcrm?schema=public"

# ---- Auth ----
# Any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ---- Server ----
PORT=4001
NODE_ENV=development

# ---- CORS ----
# Comma separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS="http://localhost:5173"
